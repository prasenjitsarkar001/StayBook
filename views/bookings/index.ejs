<% layout("/layouts/boilerplate") %>

<div class="container py-5">

  <div class="text-center mb-5">

    <h2 class="fw-bold">
      My Bookings
    </h2>

    <p class="text-muted">
      View your booking and payment history.
    </p>

  </div>


  <% if (bookings.length === 0) { %>

    <div class="text-center py-5">

      <i
        class="fa-solid fa-calendar-xmark text-muted"
        style="font-size: 60px;"
      ></i>

      <h4 class="mt-4">
        No bookings yet
      </h4>

      <p class="text-muted">
        Start exploring properties and make your first booking.
      </p>

      <a
        href="/listings"
        class="btn btn-dark"
      >
        Explore Listings
      </a>

    </div>

  <% } else { %>


    <div class="row g-4">

      <% bookings.forEach(booking => { %>

        <div class="col-lg-6">

          <div class="card border-0 shadow-sm rounded-4 h-100">

            <div class="card-body p-4">

              <div class="d-flex justify-content-between align-items-start">

                <div>

                  <h5 class="fw-bold mb-1">

                    <%= booking.listing.title %>

                  </h5>

                  <p class="text-muted mb-3">

                    <i class="fa-solid fa-location-dot me-1"></i>

                    <%= booking.listing.location %>,
                    <%= booking.listing.country %>

                  </p>

                </div>


                <% if (booking.paymentStatus === "paid") { %>

                  <span class="badge bg-success">
                    Paid
                  </span>

                <% } else if (booking.paymentStatus === "created") { %>

                  <span class="badge bg-warning text-dark">
                    Pending
                  </span>

                <% } else { %>

                  <span class="badge bg-danger">
                    Failed
                  </span>

                <% } %>

              </div>


              <hr>


              <div class="d-flex justify-content-between mb-2">

                <span class="text-muted">
                  Property Price
                </span>

                <span>
                  &#8377;<%= booking.basePrice.toLocaleString("en-IN") %>
                </span>

              </div>


              <div class="d-flex justify-content-between mb-2">

                <span class="text-muted">
                  Tax
                </span>

                <span>
                  &#8377;<%= booking.tax.toLocaleString("en-IN") %>
                </span>

              </div>


              <div class="d-flex justify-content-between fw-bold">

                <span>
                  Total
                </span>

                <span>
                  &#8377;<%= booking.totalAmount.toLocaleString("en-IN") %>
                </span>

              </div>


              <hr>


              <small class="text-muted">

                Booked on:
                <%= booking.createdAt.toDateString() %>

              </small>


              <div class="mt-3">

                <a
                  href="/bookings/<%= booking._id %>"
                  class="btn btn-outline-dark btn-sm"
                >
                  View Booking
                </a>

              </div>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  <% } %>

</div>