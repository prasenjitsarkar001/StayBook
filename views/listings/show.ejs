<% layout("/layouts/boilerplate") %>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>
        <%= listing.title %>
      </h3>
    </div>
    <div class="card shadow-sm col-6 offset-2">
      <!-- Show full image without cropping -->
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>"
        style="height: 400px; object-fit: cover; border-radius: 0.5rem 0.5rem 0 0;">

      <div class="card-body">
        <p class="card-text"> Owned By :
          <i>
            <%= listing.owner ? listing.owner.username : "Unknown" %>
          </i>
          <br>
        </p>
        <p>
          <%= listing.description %>
        </p>
        <% const basePrice=listing.price || 0; const tax=Math.round(basePrice * 0.18); const totalPrice=basePrice + tax;
          %>

          <p class="card-text text-muted">
            &#8377;<%= basePrice.toLocaleString("en-IN") %> /night
          </p>

          <p class="card-text">
            <%= listing.location %><br>
          </p>
          <p class="card-text">
            <%= listing.country %>
          </p>
          <% if (currUser && listing.owner && !currUser._id.equals(listing.owner._id)) { %>

            <form action="/bookings/preview/<%= listing._id %>" method="POST" class="mt-4">

              <!-- Check-in -->
              <div class="mb-3">
                <label for="checkIn" class="form-label fw-semibold">
                  Check-in
                </label>

                <input type="date" id="checkIn" name="checkIn" class="form-control" required>
              </div>


              <!-- Check-out -->
              <div class="mb-3">
                <label for="checkOut" class="form-label fw-semibold">
                  Check-out
                </label>

                <input type="date" id="checkOut" name="checkOut" class="form-control" required>
              </div>


              <!-- Guests -->
              <div class="mb-3">
                <label for="guests" class="form-label fw-semibold">
                  Guests
                </label>

                <select id="guests" name="guests" class="form-select" required>
                  <option value="1" selected>1 guest</option>
                  <option value="2">2 guests</option>
                  <option value="3">3 guests</option>
                  <option value="4">4 guests</option>
                  <option value="5">5 guests</option>
                  <option value="6">6 guests</option>
                  <option value="7">7 guests</option>
                  <option value="8">8 guests</option>
                </select>
              </div>


              <!-- Rooms -->
              <div class="mb-3">
                <label for="rooms" class="form-label fw-semibold">
                  Rooms
                </label>

                <select id="rooms" name="rooms" class="form-select" required>
                  <option value="1" selected>1 room</option>
                  <option value="2">2 rooms</option>
                  <option value="3">3 rooms</option>
                  <option value="4">4 rooms</option>
                  <option value="5">5 rooms</option>
                </select>
              </div>


              <button type="submit" class="btn btn-success w-100">
                Reserve
              </button>

            </form>

            <% } %>

              <br />


              <%if(currUser && listing.owner && listing.owner._id && currUser._id.equals(listing.owner._id)){%>
                <div class="btns d-flex gap-3 mt-3">
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark  edit-btn ">Edit</a>
                  <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark  ">Delete</button>
                  </form>
                </div>
                <%}%>
      </div>
    </div>
    <div class="col-8 offset-2 mb-3">
      <hr>
      <h4>
        Leave a Review
      </h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">

            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
              aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">Please add some comments for review </div>
        </div>
        <button class="btn btn-dark">Submit</button>
      </form>
      <hr>
      <h3 class="mt-4 mb-3">All Reviews</h3>

      <% if (listing.reviews.length===0) { %>
        <p class="text-muted">No reviews yet. Be the first to review!</p>
        <% } %>

          <% for (let review of listing.reviews) { %>
            <div class="card shadow-sm mb-3">
              <div class="card-body">
                <!-- Username -->
                <h6 class="mb-1 text-primary">
                  <i class="fa-solid fa-user"></i>
                  <%= review.author ? review.author.username : "Anonymous" %>
                </h6>

                <!-- Rating -->
                <div class="mb-2">
                  <% for (let i=0; i < review.rating; i++) { %>
                    <span class="text-warning">&#9733;</span>
                    <% } %>
                      <% for (let i=review.rating; i < 5; i++) { %>
                        <span class="text-secondary">&#9733;</span>
                        <% } %>
                </div>

                <!-- Comment -->
                <p class="card-text mb-1">
                  <%= review.comment %>
                </p>

                <!-- Date -->
                <small class="text-muted">
                  Reviewed on <%= review.createAt.toDateString() %>
                </small>

                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-danger">Delete</button>
                  </form>
                  <% } %>

              </div>
            </div>
            <% } %>
    </div>
  </div>