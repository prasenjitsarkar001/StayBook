<% layout("/layouts/boilerplate") %>

<div class="container py-5">

  <div class="row justify-content-center">

    <div class="col-lg-7 col-md-9">

      <!-- Page heading -->
      <div class="text-center mb-4">
        <h2 class="fw-bold">Complete Your Booking</h2>
        <p class="text-muted mb-0">
          Review your booking details and proceed with secure payment.
        </p>
      </div>


      <!-- Booking Card -->
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- Property Header -->
        <div class="card-body p-4">

          <div class="mb-4">

            <h4 class="fw-bold mb-2">
              <%= listing.title %>
            </h4>

            <div class="text-muted">
              <i class="fa-solid fa-location-dot me-1"></i>
              <%= listing.location %>, <%= listing.country %>
            </div>

          </div>


          <hr>


          <!-- Price Details -->

          <h5 class="fw-bold mb-3">
            Price Details
          </h5>

          <div class="d-flex justify-content-between mb-3">

            <span class="text-muted">
              Property price
            </span>

            <span>
              &#8377;<%= booking.basePrice.toLocaleString("en-IN") %>
            </span>

          </div>


          <div class="d-flex justify-content-between mb-3">

            <span class="text-muted">
              Tax (18%)
            </span>

            <span>
              &#8377;<%= booking.tax.toLocaleString("en-IN") %>
            </span>

          </div>


          <hr>


          <!-- Total -->

          <div class="d-flex justify-content-between align-items-center mb-4">

            <span class="fw-bold fs-5">
              Total Amount
            </span>

            <span class="fw-bold fs-4">
              &#8377;<%= booking.totalAmount.toLocaleString("en-IN") %>
            </span>

          </div>


          <!-- Payment Button -->

          <button
            id="pay-btn"
            class="btn btn-success btn-lg w-100 rounded-3"
          >
            <i class="fa-solid fa-lock me-2"></i>
            Pay &#8377;<%= booking.totalAmount.toLocaleString("en-IN") %>
          </button>


          <!-- Security message -->

          <div class="text-center mt-3">

            <small class="text-muted">
              <i class="fa-solid fa-shield-halved me-1"></i>
              Secure payment powered by Razorpay
            </small>

          </div>


          <!-- Payment message -->

          <div id="payment-message" class="mt-3"></div>

        </div>

      </div>


      <!-- Back button -->

      <div class="text-center mt-4">

        <a
          href="/listings/<%= listing._id %>"
          class="text-decoration-none text-muted"
        >
          ← Back to property
        </a>

      </div>

    </div>

  </div>

</div>


<!-- Razorpay Checkout -->

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<script>

  const payButton = document.getElementById("pay-btn");
  const message = document.getElementById("payment-message");


  payButton.addEventListener("click", function () {

    const options = {

      key: "<%= razorpayKeyId %>",

      amount: "<%= order.amount %>",

      currency: "<%= order.currency %>",

      name: "StayBook",

      description: "<%= listing.title %>",

      order_id: "<%= order.id %>",


      handler: async function (response) {

        try {

          payButton.disabled = true;

          payButton.innerHTML = `
            <span class="spinner-border spinner-border-sm me-2"></span>
            Verifying Payment...
          `;


          const result = await fetch("/payment/verify", {

            method: "POST",

            headers: {
              "Content-Type": "application/json"
            },

            body: JSON.stringify({

              bookingId: "<%= booking._id %>",

              razorpay_payment_id:
                response.razorpay_payment_id,

              razorpay_order_id:
                response.razorpay_order_id,

              razorpay_signature:
                response.razorpay_signature

            })

          });


          const data = await result.json();


          if (data.success) {

            window.location.href = `/bookings/${data.bookingId}`;

          } else {

            message.innerHTML = `
              <div class="alert alert-danger">
                ${data.message}
              </div>
            `;

            payButton.disabled = false;

            payButton.innerHTML = `
              <i class="fa-solid fa-lock me-2"></i>
              Pay &#8377;<%= booking.totalAmount.toLocaleString("en-IN") %>
            `;

          }


        } catch (error) {

          console.error(error);

          message.innerHTML = `
            <div class="alert alert-danger">
              Something went wrong while verifying your payment.
              Please contact support if money was deducted.
            </div>
          `;

          payButton.disabled = false;

          payButton.innerHTML = `
            <i class="fa-solid fa-lock me-2"></i>
            Pay &#8377;<%= booking.totalAmount.toLocaleString("en-IN") %>
          `;

        }

      },


      prefill: {

        name: "<%= currUser ? currUser.username : '' %>"

      },


      theme: {

        color: "#198754"

      }

    };


    const razorpay = new Razorpay(options);


    razorpay.on("payment.failed", function (response) {

      console.log(response.error);

      message.innerHTML = `
        <div class="alert alert-danger">
          <strong>Payment Failed</strong>
          <br>
          Please try again.
        </div>
      `;

      payButton.disabled = false;

      payButton.innerHTML = `
        <i class="fa-solid fa-lock me-2"></i>
        Pay &#8377;<%= booking.totalAmount.toLocaleString("en-IN") %>
      `;

    });


    razorpay.open();

  });

</script>